DATABASE_URL=sqlite:///./backend/studypilot.db
JWT_SECRET=replace-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
AUTO_CREATE_TABLES=true
SYNC_DOCUMENT_PROCESSING=false
UPLOAD_DIR=./backend/storage/uploads
PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGE=chi_sim+eng
PDF_OCR_DPI=300
PDF_OCR_MIN_TEXT_CHARS=80
EMBEDDING_DIMENSION=1024

# Qwen through DashScope's OpenAI-compatible endpoint. Keep the key empty in
# this tracked template and enter a newly rotated key only in local .env.
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_CHAT_MODEL=qwen3.7-plus
LLM_EMBEDDING_MODEL=qwen3.7-text-embedding
LLM_EMBEDDING_BATCH_SIZE=20
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

